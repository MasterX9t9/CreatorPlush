# ==============================================================================
# CreatorPulse Environment Configuration Template
# Copy this file to .env.local or .env in your development environment
# ==============================================================================

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creatorpulse?schema=public"
# DIRECT_URL is optional, used for Prisma migrations when behind a connection pooler like PgBouncer
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/creatorpulse?schema=public"

# Application Base URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-in-production"

# Cryptographic Keys
# Must be a 32-byte secret (e.g., 64-char hex string) for AES-256-GCM OAuth token encryption
ENCRYPTION_KEY_32_BYTES="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="your-jwt-secret-for-api-and-extension-bearer-tokens"

# Google & YouTube APIs
# YouTube Data API v3 Server Key for public queries (search, public video/channel stats)
YOUTUBE_API_KEY="AIzaSyYourGoogleApiKeyHere"

# Google OAuth 2.0 Credentials (for connecting creator channels and YouTube Analytics API)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/youtube/callback"

# AI Providers (At least one provider required for Grounded AI Creator features)
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="sk-your-openai-api-key-optional"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key-optional"

# Cache & Rate Limiting (Redis)
# Leave blank or use local Redis for caching search queries and rate limiting
REDIS_URL="redis://localhost:6379"

# Stripe Billing (Required for subscription tiers & webhook validation)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_CREATOR="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_AGENCY="price_..."

# Application Defaults
DEFAULT_LOCALE="en"
NODE_ENV="development"
