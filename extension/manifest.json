{
  "manifest_version": 3,
  "name": "CreatorPulse - YouTube Creator Intelligence",
  "version": "1.0.0",
  "description": "Real-time statistical outliers, thumbnail insights, and one-click Swipe File research directly on YouTube.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open CreatorPulse Intelligence Panel"
  }
}
