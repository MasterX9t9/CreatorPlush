generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS
// ==========================================

enum Role {
  OWNER
  ADMIN
  EDITOR
  ANALYST
  VIEWER
}

enum PlanTier {
  FREE
  CREATOR
  PRO
  AGENCY
}

enum SwipeItemType {
  VIDEO
  CHANNEL
  THUMBNAIL
  TITLE
  HOOK
  TRANSCRIPT
}

enum TriggerType {
  OUTLIER_VIDEO
  SUB_MILESTONE
  COMPETITOR_UPLOAD
  VIEW_SPIKE
}

enum JobState {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ==========================================
// 2. AUTHENTICATION & MULTI-TENANCY
// ==========================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  emailVerified DateTime?
  locale        String       @default("en")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships   TeamMember[]
  auditLogs     AuditLog[]
}

model Workspace {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  members         TeamMember[]
  subscription    Subscription?
  usageRecords    UsageRecord[]
  youtubeAccounts YouTubeAccount[]
  trackedChannels TrackedChannel[]
  trackedKeywords TrackedKeyword[]
  competitors     Competitor[]
  swipeFolders    SwipeFolder[]
  swipeItems      SwipeItem[]
  alerts          Alert[]
  notifications   Notification[]
  reports         Report[]
  reportSchedules ReportSchedule[]
  automations     Automation[]
  apiKeys         ApiKey[]
  webhooks        Webhook[]
  aiConversations AIConversation[]
  aiAnalyses      AIAnalysis[]
  auditLogs       AuditLog[]

  @@index([slug])
}

model TeamMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(EDITOR)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Subscription {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  tier                 PlanTier  @default(FREE)
  status               String    @default("active")
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id          String   @id @default(cuid())
  workspaceId String
  metric      String
  count       Int      @default(0)
  periodDate  String
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, periodDate])
  @@index([workspaceId, periodDate])
}

// ==========================================
// 3. YOUTUBE ACCOUNTS & CORE CATALOG
// ==========================================

model YouTubeAccount {
  id             String    @id @default(cuid())
  workspaceId    String
  googleId       String
  email          String
  channelId      String?
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  scopes         String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels       Channel[]

  @@unique([workspaceId, googleId])
  @@index([workspaceId])
}

model Channel {
  id                    String    @id
  youtubeAccountId      String?
  title                 String
  customUrl             String?
  description           String?
  publishedAt           DateTime?
  avatarUrl             String?
  bannerUrl             String?
  country               String?
  defaultLanguage       String?

  subscriberCount       BigInt    @default(0)
  viewCount             BigInt    @default(0)
  videoCount            Int       @default(0)

  avgViewsPerVideo      Float?
  medianViews           Float?
  uploadFrequencyWeekly Float?
  estimatedRpmMin       Float?
  estimatedRpmMax       Float?
  facelessLikelihood    Float?
  outlierPercentage     Float?

  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  youtubeAccount        YouTubeAccount?  @relation(fields: [youtubeAccountId], references: [id], onDelete: SetNull)
  snapshots             ChannelSnapshot[]
  videos                Video[]
  shorts                Short[]
  trackedBy             TrackedChannel[]
  competitorRecords     Competitor[]

  @@index([title])
  @@index([subscriberCount])
  @@index([viewCount])
}

model ChannelSnapshot {
  id          String   @id @default(cuid())
  channelId   String
  subscribers BigInt
  views       BigInt
  videosCount Int
  source      String   @default("youtube_data_api")
  capturedAt  DateTime @default(now())

  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, capturedAt])
}

model Video {
  id               String    @id
  channelId        String
  title            String
  description      String?
  publishedAt      DateTime
  durationSec      Int       @default(0)
  isShort          Boolean   @default(false)
  thumbnailUrl     String
  tags             String[]
  categoryId       String?
  defaultAudioLang String?

  viewCount        BigInt    @default(0)
  likeCount        BigInt?
  commentCount     BigInt?

  viewsPerHour     Float?
  viewsPerDay      Float?
  engagementRate   Float?
  expectedViews    Float?
  outlierScore     Float?
  outlierTier      String?

  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  channel          Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  snapshots        VideoSnapshot[]
  thumbnailAnalysis ThumbnailAnalysis?
  titleAnalysis     TitleAnalysis?
  transcript        Transcript?
  commentAnalyses   CommentAnalysis[]

  @@index([channelId, publishedAt])
  @@index([isShort])
  @@index([outlierScore])
  @@index([viewCount])
}

model VideoSnapshot {
  id         String   @id @default(cuid())
  videoId    String
  views      BigInt
  likes      BigInt?
  comments   BigInt?
  capturedAt DateTime @default(now())

  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, capturedAt])
}

model Short {
  id             String    @id
  channelId      String
  title          String
  publishedAt    DateTime
  durationSec    Int       @default(0)
  thumbnailUrl   String
  viewCount      BigInt    @default(0)
  likeCount      BigInt?
  commentCount   BigInt?
  outlierScore   Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, publishedAt])
  @@index([outlierScore])
}

// ==========================================
// 4. RESEARCH & DISCOVERY
// ==========================================

model Keyword {
  id               String    @id @default(cuid())
  term             String    @unique
  competitionScore Float?
  searchInterest   Int?
  opportunityScore Float?
  relatedTerms     String[]
  lastCheckedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  snapshots        KeywordSnapshot[]

  @@index([term])
}

model KeywordSnapshot {
  id               String   @id @default(cuid())
  keywordId        String
  searchInterest   Int?
  competitionScore Float?
  opportunityScore Float?
  capturedAt       DateTime @default(now())

  keyword          Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, capturedAt])
}

model Niche {
  id                   String    @id @default(cuid())
  name                 String    @unique
  category             String
  averageViews         Float?
  competitionLevel     String?
  estimatedRpmMin      Float?
  estimatedRpmMax      Float?
  nicheOpportunityScore Float?
  topKeywords          String[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([name])
}

model Search {
  id          String   @id @default(cuid())
  query       String
  filters     Json?
  resultCount Int      @default(0)
  source      String   @default("youtube_data_api")
  createdAt   DateTime @default(now())

  results     SearchResult[]

  @@index([query, createdAt])
}

model SearchResult {
  id         String   @id @default(cuid())
  searchId   String
  entityType String   // "VIDEO" | "CHANNEL"
  entityId   String
  position   Int
  metadata   Json?
  createdAt  DateTime @default(now())

  search     Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId, position])
}

// ==========================================
// 5. TRACKING & COMPETITORS
// ==========================================

model TrackedChannel {
  id          String    @id @default(cuid())
  workspaceId String
  channelId   String
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channelId])
  @@index([workspaceId])
}

model Competitor {
  id          String    @id @default(cuid())
  workspaceId String
  channelId   String
  threatLevel String?   @default("MEDIUM")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channelId])
  @@index([workspaceId])
}

model TrackedKeyword {
  id               String    @id @default(cuid())
  workspaceId      String
  keyword          String
  targetRegion     String    @default("US")
  opportunityScore Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, keyword, targetRegion])
  @@index([workspaceId])
}

// ==========================================
// 6. SWIPE FILE LIBRARY
// ==========================================

model SwipeFolder {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String?     @default("#e11d48")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       SwipeItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model SwipeItem {
  id           String        @id @default(cuid())
  workspaceId  String
  folderId     String?
  itemType     SwipeItemType
  externalId   String?
  title        String
  description  String?
  thumbnailUrl String?
  url          String?
  notes        String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder       SwipeFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags         SwipeTag[]
  swipeNotes   SwipeNote[]

  @@index([workspaceId, itemType])
  @@index([workspaceId, folderId])
}

model SwipeTag {
  id          String    @id @default(cuid())
  name        String
  itemId      String

  item        SwipeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, name])
  @@index([name])
}

model SwipeNote {
  id          String    @id @default(cuid())
  itemId      String
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  item        SwipeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// ==========================================
// 7. CONTENT INTELLIGENCE & THUMBNAILS
// ==========================================

model Thumbnail {
  id         String    @id @default(cuid())
  imageUrl   String
  width      Int?
  height     Int?
  createdAt  DateTime  @default(now())
}

model ThumbnailAnalysis {
  id              String   @id @default(cuid())
  videoId         String?  @unique
  imageUrl        String
  clarityScore    Float
  contrastScore   Float
  faceCount       Int      @default(0)
  hasText         Boolean  @default(false)
  textDensity     Float?
  strengths       String[]
  weaknesses      String[]
  recommendations String[]
  analyzedAt      DateTime @default(now())

  video           Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model TitleAnalysis {
  id              String   @id @default(cuid())
  videoId         String?  @unique
  title           String
  overallScore    Float
  charCount       Int
  wordCount       Int
  hasPowerWords   Boolean
  emotionalTone   String?
  strengths       String[]
  weaknesses      String[]
  suggestedTitles String[]
  analyzedAt      DateTime @default(now())

  video           Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Transcript {
  id              String   @id @default(cuid())
  videoId         String   @unique
  language        String   @default("en")
  isAutoGenerated Boolean  @default(true)
  fullText        String   @db.Text
  segments        Json
  fetchedAt       DateTime @default(now())

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  analysis        TranscriptAnalysis?
}

model TranscriptAnalysis {
  id           String     @id @default(cuid())
  transcriptId String     @unique
  hookSummary  String?
  keyPoints    String[]
  topicGaps    String[]
  structure    Json?
  analyzedAt   DateTime   @default(now())

  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
}

model CommentAnalysis {
  id              String   @id @default(cuid())
  videoId         String
  sampleCount     Int      @default(0)
  positivePct     Float
  neutralPct      Float
  negativePct     Float
  topThemes       String[]
  viewerRequests  String[]
  commonQuestions String[]
  analyzedAt      DateTime @default(now())

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

// ==========================================
// 8. AI INTELLIGENCE LAYER
// ==========================================

model AIConversation {
  id          String      @id @default(cuid())
  workspaceId String
  title       String
  contextType String?
  contextId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    AIMessage[]

  @@index([workspaceId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  sender         String
  content        String         @db.Text
  citations      Json?
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AIAnalysis {
  id          String    @id @default(cuid())
  workspaceId String
  analysisType String   // "STRATEGY" | "NICHE_REPORT" | "COMPETITOR_GAP"
  targetId    String?
  resultJson  Json
  citations   Json?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, analysisType])
}

// ==========================================
// 9. AUTOMATION, ALERTS & REPORTS
// ==========================================

model Alert {
  id              String      @id @default(cuid())
  workspaceId     String
  name            String
  triggerType     TriggerType
  targetId        String
  condition       Json
  channelNotify   Boolean     @default(true)
  emailNotify     Boolean     @default(false)
  webhookUrl      String?
  lastTriggeredAt DateTime?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  message     String
  type        String    @default("INFO")
  isRead      Boolean   @default(false)
  linkUrl     String?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isRead])
}

model Report {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  reportType  String
  dateRange   String
  pdfUrl      String?
  jsonData    Json
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ReportSchedule {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  frequency   String    // "DAILY" | "WEEKLY" | "MONTHLY"
  recipientEmail String
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

model Automation {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  schedule    String
  taskType    String
  status      JobState  @default(QUEUED)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String    @unique
  prefix      String
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Webhook {
  id          String    @id @default(cuid())
  workspaceId String
  url         String
  secretKey   String
  events      String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id          String     @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}
